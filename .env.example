# Faultline Environment Configuration

# Gemini API Key (optional for offline testing/fake provider, required for live reasoning)
GEMINI_API_KEY=

# Model Policy:
# Gemini 3.7 Flash is the intended primary model; application verifies exact accessible API model ID at startup,
# with Gemini 3.6 Flash as verified fallback.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Thinking level for Gemini ('low', 'medium', 'high'). Medium is recommended for balanced operational speed.
GEMINI_THINKING_LEVEL=medium

# Server Port
PORT=8000
HOST=0.0.0.0
