# Faultline Environment Configuration

# Gemini API Key (optional for offline testing/fake provider, required for live reasoning)
GEMINI_API_KEY=

# Preferred Gemini model ID. Application validates model on startup:
# If gemini-3.7-flash is accessible, it is used as primary with gemini-3.6-flash as fallback.
# Otherwise, gemini-3.6-flash is used as primary.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Thinking level for Gemini ('low', 'medium', 'high'). Medium is recommended for balanced operational speed.
GEMINI_THINKING_LEVEL=medium

# Server Port
PORT=8000
HOST=0.0.0.0
